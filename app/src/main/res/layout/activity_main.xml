<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textStyle="bold"
            android:textSize="21sp"
            android:textColor="@color/white"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/addressInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="ألصق رابط HTTPS هنا"
                android:singleLine="true"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:background="@drawable/input_background"
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:paddingHorizontal="12dp"
                android:textDirection="ltr"
                android:gravity="center_vertical|start"
                android:textSize="13sp" />

            <Button
                android:id="@+id/goButton"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:text="فتح"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:background="@drawable/primary_button" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/browserPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/backButton"
                    android:layout_width="45dp"
                    android:layout_height="44dp"
                    android:text="رجوع"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/secondary_button" />

                <Button
                    android:id="@+id/forwardButton"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="تقدم"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/secondary_button" />

                <Button
                    android:id="@+id/reloadButton"
                    android:layout_width="50dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="تحديث"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="@drawable/secondary_button" />

                <Button
                    android:id="@+id/mediaButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="الوسائط المكتشفة (0)"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"
                    android:background="@drawable/primary_button" />
            </LinearLayout>

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layoutDirection="ltr" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloadsPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تنزيلاتك"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:paddingVertical="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اضغط على ملف مكتمل لفتحه، أو اضغط مطولًا لإلغاء تنزيل جارٍ."
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:paddingBottom="10dp" />

            <ListView
                android:id="@+id/downloadsList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:background="@color/surface">

        <Button
            android:id="@+id/browserTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="المتصفح"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:background="@drawable/primary_button" />

        <Button
            android:id="@+id/downloadsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="التنزيلات"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/secondary_button" />
    </LinearLayout>
</LinearLayout>
