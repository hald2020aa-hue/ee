<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="65dp"
        android:paddingHorizontal="18dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"
            android:background="@drawable/primary_button" android:text="▶" android:textColor="@color/bg"
            android:textSize="22sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EE TUBE" android:textColor="@color/white" android:textStyle="bold"
                android:textSize="21sp" android:letterSpacing="0.08" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="التحميل الذكي للفيديو والصوت" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="v0.2" android:textColor="@color/accent" android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/homePane" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <EditText android:id="@+id/homeSearchInput" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:singleLine="true"
                        android:inputType="textUri" android:imeOptions="actionSearch"
                        android:hint="ابحث أو ألصق رابط الفيديو" android:background="@drawable/input_background"
                        android:textSize="13sp" android:textColor="@color/white"
                        android:textColorHint="@color/muted" android:paddingHorizontal="16dp" />
                    <Button android:id="@+id/homeSearchButton" android:layout_width="75dp"
                        android:layout_height="match_parent" android:layout_marginStart="8dp"
                        android:text="بحث" android:textAllCaps="false" android:textColor="@color/bg"
                        android:background="@drawable/primary_button" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp" android:layout_marginTop="18dp"
                    android:background="@drawable/hero_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="فيديو أو صوت؟\nحمّل بطريقتك." android:textSize="26sp"
                        android:textColor="@color/white" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="9dp" android:text="افتح موقعك المفضل، شغّل الفيديو، وبعدها اختر الوسائط والجودة المتاحة." 
                        android:textSize="13sp" android:lineSpacingExtra="3dp" android:textColor="@color/white" />
                    <Button android:id="@+id/openBrowserButton" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:layout_marginTop="14dp"
                        android:paddingHorizontal="22dp" android:text="افتح المتصفح  ←"
                        android:textAllCaps="false" android:textStyle="bold"
                        android:textColor="@color/bg" android:background="@drawable/primary_button" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="25dp" android:text="المواقع الشائعة"
                    android:textColor="@color/white" android:textStyle="bold" android:textSize="19sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="افتح الموقع داخل المتصفح. توفر التنزيل يختلف حسب الموقع."
                    android:textSize="12sp" android:textColor="@color/muted" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:layout_marginTop="14dp">
                    <Button android:id="@+id/quickYoutube" style="@style/SiteButton" android:text="▶  YouTube" />
                    <Button android:id="@+id/quickInstagram" style="@style/SiteButton" android:text="◎  Instagram" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/quickTikTok" style="@style/SiteButton" android:text="♫  TikTok" />
                    <Button android:id="@+id/quickFacebook" style="@style/SiteButton" android:text="f  Facebook" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/quickVimeo" style="@style/SiteButton" android:text="▶  Vimeo" />
                    <Button android:id="@+id/quickDailymotion" style="@style/SiteButton" android:text="▷  Dailymotion" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:text="مكتبتي" android:textColor="@color/white"
                    android:textStyle="bold" android:textSize="19sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <Button android:id="@+id/savedSitesButton" style="@style/SiteButton" android:text="☆  المواقع المحفوظة" />
                    <Button android:id="@+id/recentSitesButton" style="@style/SiteButton" android:text="◷  سجل التصفح" />
                </LinearLayout>
                <Button android:id="@+id/openDownloadsButton" android:layout_width="match_parent"
                    android:layout_height="53dp" android:layout_marginTop="14dp" android:text="⬇  عرض التنزيلات"
                    android:textColor="@color/accent" android:textAllCaps="false"
                    android:background="@drawable/secondary_button" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/browserPane" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:paddingHorizontal="10dp">
                <EditText android:id="@+id/addressInput" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:hint="رابط الموقع" android:singleLine="true" android:inputType="textUri"
                    android:imeOptions="actionGo" android:selectAllOnFocus="true" android:paddingHorizontal="12dp"
                    android:textColor="@color/white" android:textColorHint="@color/muted"
                    android:background="@drawable/input_background" android:textDirection="ltr"
                    android:gravity="center_vertical|start" android:textSize="12sp" />
                <Button android:id="@+id/goButton" android:layout_width="62dp" android:layout_height="match_parent"
                    android:layout_marginStart="6dp" android:text="فتح" android:textAllCaps="false"
                    android:textColor="@color/bg" android:background="@drawable/primary_button" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:paddingHorizontal="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                <Button android:id="@+id/backButton" style="@style/BrowserButton" android:text="❮" />
                <Button android:id="@+id/forwardButton" style="@style/BrowserButton" android:text="❯" />
                <Button android:id="@+id/reloadButton" style="@style/BrowserButton" android:text="↻" />
                <Button android:id="@+id/bookmarkButton" style="@style/BrowserButton" android:text="☆" />
                <Button android:id="@+id/mediaButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="44dp" android:layout_marginStart="7dp"
                    android:text="⬇  الوسائط (0)" android:textSize="12sp" android:textAllCaps="false"
                    android:textColor="@color/bg" android:background="@drawable/primary_button" />
            </LinearLayout>
            <ProgressBar android:id="@+id/loadingBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="3dp" android:max="100"
                android:progressTint="@color/accent" />
            <WebView android:id="@+id/webView" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" />
        </LinearLayout>

        <LinearLayout android:id="@+id/downloadsPane" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" android:orientation="vertical"
            android:paddingHorizontal="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="15dp" android:paddingBottom="8dp" android:text="تنزيلاتي"
                android:textStyle="bold" android:textSize="24sp" android:textColor="@color/white" />
            <TextView android:id="@+id/hlsStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="12dp" android:textSize="12sp"
                android:background="@drawable/input_background" android:textColor="@color/accent"
                android:text="حالة تنزيل البث HLS" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="10dp" android:paddingBottom="10dp" android:textSize="12sp"
                android:textColor="@color/muted"
                android:text="الملفات المباشرة: اضغط للفتح • اضغط مطولًا للإلغاء أو الحذف" />
            <ListView android:id="@+id/downloadsList" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:divider="@android:color/transparent" android:dividerHeight="8dp" />
        </LinearLayout>

        <ScrollView android:id="@+id/settingsPane" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="الإعدادات" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="EE Tube — النسخة التجريبية 0.2" android:textColor="@color/accent"
                    android:layout_marginTop="12dp" android:textSize="16sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:lineSpacingExtra="6dp" android:textSize="14sp"
                    android:textColor="@color/white" android:text="• تنزيل MP4 وMP3 وWebM ومصادر الملفات المباشرة.\n• تنزيل HLS غير المشفّر عند استخدام مقاطع TS، مع اختيار الجودة من القائمة المتاحة.\n• بعض المواقع تتطلب مشغلات أو تواقيع لا يدعمها هذا الإصدار.\n• التحويل إلى MP3 وتنزيل DASH وDRM غير متاح.\n• تنزيلات HLS لا تستأنف تلقائيًا بعد إغلاق العملية." />
                <Button android:id="@+id/clearHistoryButton" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="18dp"
                    android:text="مسح سجل التصفح" android:textAllCaps="false"
                    android:textColor="@color/white" android:background="@drawable/secondary_button" />
                <Button android:id="@+id/clearBookmarksButton" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="12dp"
                    android:text="مسح المواقع المحفوظة" android:textAllCaps="false"
                    android:textColor="@color/white" android:background="@drawable/secondary_button" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="26dp" android:textSize="13sp" android:lineSpacingExtra="4dp"
                    android:textColor="@color/muted"
                    android:text="للاستخدام مع المحتوى المسموح بتنزيله فقط. لا يتضمن التطبيق شيفرة أو موارد من Snaptube." />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="67dp"
        android:paddingHorizontal="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:orientation="horizontal" android:background="@color/surface">
        <Button android:id="@+id/homeTab" style="@style/BottomButton" android:text="⌂  الرئيسية" />
        <Button android:id="@+id/browserTab" style="@style/BottomButton" android:text="◎  المتصفح" />
        <Button android:id="@+id/downloadsTab" style="@style/BottomButton" android:text="↓  التنزيلات" />
        <Button android:id="@+id/settingsTab" style="@style/BottomButton" android:text="⚙  الإعدادات" />
    </LinearLayout>
</LinearLayout>
